# Copy this file to ".env" and fill in your values.

# --- LLM: Google Gemini (OpenAI-compatible endpoint) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Database backend ---
# chdb            = embedded ClickHouse, no server (dummy-data phase)
# clickhouse_http = real ClickHouse endpoint (when you have real data)
DB_BACKEND=chdb
DB_NAME=turtlemint

# --- Real ClickHouse (only used when DB_BACKEND=clickhouse_http) ---
# CLICKHOUSE_URL=https://clickhouse.internal:8443
# CLICKHOUSE_USER=nlsql_ro
# CLICKHOUSE_PASSWORD=

# --- Guardrails ---
DEFAULT_ROW_LIMIT=1000
QUERY_TIMEOUT_S=30

# --- Pipeline / hardening ---
ENABLE_PROMPT_ENHANCER=true
ENABLE_RESULT_FORMATTER=true
MAX_QUERIES_PER_DAY=200
# EMBED_MODEL=gemini-embedding-001
# LLM_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite
